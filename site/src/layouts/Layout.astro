---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { siteConfig, type Locale } from "../site.config";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  jsonLd?: unknown[];
  current?: "home" | "harness" | "compare";
}
const { locale, title, description, path, jsonLd, current } = Astro.props;
const htmlLang = siteConfig.locales.find((l) => l.id === locale)?.htmlLang ?? "en";
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <BaseHead locale={locale} title={title} description={description} path={path} jsonLd={jsonLd} />
  </head>
  <body>
    <Header locale={locale} current={current} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
